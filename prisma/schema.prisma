// Prisma schema for MovieShop (auth handled externally by better-auth)
// Keep user-related models out of this schema; we store user IDs as strings
// so the auth library/adapter can manage users/sessions/accounts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PersonRole {
  DIRECTOR
  ACTOR
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model Movie {
  id          String        @id @default(cuid())
  title       String
  description String
  price       Decimal       @db.Decimal(10, 2)
  releaseDate DateTime
  imageUrl    String?
  stock       Int           @default(0)
  runtime     Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  isArchived  Boolean       @default(false)
  genres      MovieGenre[]
  people      MoviePerson[]
  orderItems  OrderItem[]
  cartItems   CartItem[]
}

model Genre {
  id     String       @id @default(cuid())
  name   String       @unique
  movies MovieGenre[]
}

model MovieGenre {
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId String
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)
  genreId String

  @@id([movieId, genreId])
}

model Person {
  id       String        @id @default(cuid())
  fullName String        @unique
  bio      String?
  imageUrl String?
  movies   MoviePerson[]
}

model MoviePerson {
  movie    Movie      @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId  String
  person   Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId String
  role     PersonRole

  @@id([movieId, personId, role])
}

model Order {
  id          String      @id @default(cuid())
  totalAmount Decimal     @db.Decimal(10, 2)
  status      OrderStatus @default(PENDING)
  orderDate   DateTime    @default(now())

  // userId references an external auth user (managed by better-auth). No relation here.
  userId String

  items OrderItem[]

  address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  addressId String?

  @@index([userId])
}

model OrderItem {
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId         String
  movie           Movie   @relation(fields: [movieId], references: [id], onDelete: Restrict)
  movieId         String
  quantity        Int
  priceAtPurchase Decimal @db.Decimal(10, 2)

  @@id([orderId, movieId])
}

model Address {
  id         String  @id @default(cuid())
  // userId references an external auth user (managed by better-auth). No relation here.
  userId     String
  line1      String
  line2      String?
  city       String
  postalCode String
  country    String
  orders     Order[]

  @@index([userId])
}

model Cart {
  id       String     @id @default(cuid())
  // userId references an external auth user (managed by better-auth). No relation here.
  userId   String?    @unique
  items    CartItem[]
}

model CartItem {
  cart     Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId   String
  movie    Movie  @relation(fields: [movieId], references: [id], onDelete: Restrict)
  movieId  String
  quantity Int    @default(1)

  @@id([cartId, movieId])
}